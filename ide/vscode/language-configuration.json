{
    "comments": {
        "lineComment": "--",
        "blockComment": [
            "--[[",
            "]]"
        ]
    },
    "brackets": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ]
    ],
    "autoClosingPairs": [
        {
            "open": "{",
            "close": "}"
        },
        {
            "open": "[",
            "close": "]"
        },
        {
            "open": "(",
            "close": ")"
        },
        {
            "open": "\"",
            "close": "\""
        },
        {
            "open": "'",
            "close": "'"
        }
    ],
    "surroundingPairs": [
        [
            "{",
            "}"
        ],
        [
            "[",
            "]"
        ],
        [
            "(",
            ")"
        ],
        [
            "\"",
            "\""
        ],
        [
            "'",
            "'"
        ]
    ],
    "indentationRules": {
        "increaseIndentPattern": "^\\s*(class|emu|function|if|while|for|repeat|else|elseif|do).*\\{\\s*$|^\\s*(class|emu|function|if|while|for|repeat|else|elseif|do).*\\s+then\\s*$|^\\s*else\\s*$|^\\s*elseif\\s*.*\\s+then\\s*$",
        "decreaseIndentPattern": "^\\s*(end|\\}|else|elseif)\\s*$"
    }
}